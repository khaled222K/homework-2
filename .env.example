# ---------------------------------------------------------------------------
# Google Gemini API
# ---------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey and paste it below.
# This value is read ONLY by the Node backend (server/ and api/). It is never
# bundled into the frontend and must never be prefixed with VITE_.
GEMINI_API_KEY=your_api_key_here

# Optional. Pin a specific model, e.g. gemini-2.5-flash.
# Leave unset (recommended) and the backend calls the Gemini ListModels
# endpoint at runtime to pick a currently-supported generateContent model,
# so the app does not go stale as Google's model line-up changes.
# GEMINI_MODEL=

# Optional. Port for the API / production server.
PORT=3001
